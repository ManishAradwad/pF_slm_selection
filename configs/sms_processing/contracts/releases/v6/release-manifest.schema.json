{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pocketfinancer.contract-release-manifest-schema/6",
  "title": "PocketFinancer Final Native SMS Contract Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "release_id", "status", "automatic_persistence_enabled", "routing_policy", "compatibility", "algorithms", "runtime_policy", "artifacts"],
  "properties": {
    "contract": {"const": "pocketfinancer.contract-release-manifest/1"},
    "release_id": {"const": "native-integration-v6"},
    "status": {"const": "frozen_for_native_implementation"},
    "automatic_persistence_enabled": {"const": true},
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_contract", "processing_config_contract", "review_contract", "processing_result_contract", "complete_posted", "exception", "duplicate", "valid_none", "transaction_write", "retry"],
      "properties": {
        "policy_contract": {"const": "pocketfinancer.persistence-policy/2"},
        "processing_config_contract": {"const": "pocketfinancer.processing-config/6"},
        "review_contract": {"const": "pocketfinancer.review-case/2"},
        "processing_result_contract": {"const": "pocketfinancer.processing-result/3"},
        "complete_posted": {"const": "transactions"},
        "exception": {"const": "review"},
        "duplicate": {"const": "review"},
        "valid_none": {"const": "no_transaction"},
        "transaction_write": {"const": "atomic_with_operation_settlement"},
        "retry": {"const": "new_operation_with_parent_operation_id"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stored_operation_behavior", "frozen_release_ids"],
      "properties": {
        "stored_operation_behavior": {"const": "original_release"},
        "frozen_release_ids": {"const": ["native-integration-v1", "native-integration-v2", "native-integration-v3", "native-integration-v4", "native-integration-v5"]}
      }
    },
    "algorithms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_id_v1", "analysis_id_v2", "candidate_id", "canonical_json", "unicode_behavior", "source_spans", "kotlin_span_conversion", "swift_span_conversion", "account_resolution", "duplicate_assessment"],
      "properties": {
        "analysis_id_v1": {"type": "string", "minLength": 1},
        "analysis_id_v2": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "canonical_json": {"const": "utf8-json-sort-keys-compact-no-ascii-escaping"},
        "unicode_behavior": {"type": "string", "minLength": 1},
        "source_spans": {"const": "zero-based-half-open-Unicode-scalar-offsets-with-exact-text"},
        "kotlin_span_conversion": {"type": "string", "minLength": 1},
        "swift_span_conversion": {"type": "string", "minLength": 1},
        "account_resolution": {"type": "string", "minLength": 1},
        "duplicate_assessment": {"type": "string", "minLength": 1}
      }
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_mode", "decoding", "answer_token_limit", "raw_output_utf8_byte_limit", "parser_deadline_ms", "claim_lease_ms", "claim_heartbeat_ms", "automatic_retry_limit"],
      "properties": {
        "generation_mode": {"const": "DIRECT_NON_THINKING"},
        "decoding": {"const": "greedy"},
        "answer_token_limit": {"const": 512},
        "raw_output_utf8_byte_limit": {"const": 16384},
        "parser_deadline_ms": {"const": 0},
        "claim_lease_ms": {"const": 120000},
        "claim_heartbeat_ms": {"const": 15000},
        "automatic_retry_limit": {"const": 3}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contract", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
