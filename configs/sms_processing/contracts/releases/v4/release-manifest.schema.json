{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pocketfinancer.contract-release-manifest-schema/4",
  "title": "PocketFinancer Native Contract Release Manifest V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "release_id", "status", "automatic_persistence_enabled", "algorithms", "runtime_policy", "artifacts"],
  "properties": {
    "contract": {"const": "pocketfinancer.contract-release-manifest/1"},
    "release_id": {"const": "native-integration-v4"},
    "status": {"const": "frozen_for_native_implementation"},
    "automatic_persistence_enabled": {"const": false},
    "algorithms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_id_v1", "analysis_id_v2", "candidate_id", "canonical_json", "unicode_behavior", "source_spans", "kotlin_span_conversion", "swift_span_conversion", "account_resolution", "duplicate_assessment"],
      "properties": {
        "analysis_id_v1": {"type": "string", "minLength": 1},
        "analysis_id_v2": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "canonical_json": {"const": "utf8-json-sort-keys-compact-no-ascii-escaping"},
        "unicode_behavior": {"type": "string", "minLength": 1},
        "source_spans": {"const": "zero-based-half-open-Unicode-scalar-offsets-with-exact-text"},
        "kotlin_span_conversion": {"type": "string", "minLength": 1},
        "swift_span_conversion": {"type": "string", "minLength": 1},
        "account_resolution": {"type": "string", "minLength": 1},
        "duplicate_assessment": {"type": "string", "minLength": 1}
      }
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_mode", "decoding", "answer_token_limit", "raw_output_utf8_byte_limit", "parser_deadline_ms", "claim_lease_ms", "claim_heartbeat_ms", "automatic_retry_limit"],
      "properties": {
        "generation_mode": {"const": "DIRECT_NON_THINKING"},
        "decoding": {"const": "greedy"},
        "answer_token_limit": {"const": 512},
        "raw_output_utf8_byte_limit": {"const": 16384},
        "parser_deadline_ms": {"const": 0},
        "claim_lease_ms": {"const": 120000},
        "claim_heartbeat_ms": {"const": 15000},
        "automatic_retry_limit": {"const": 3}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contract", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
