{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pocketfinancer.reason-code-registry-schema/2",
  "title": "SLM-Primary SMS Reason Code Registry V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "predecessor", "legacy_meanings_frozen", "unknown_safety_code_policy", "namespaces"],
  "properties": {
    "contract": {"const": "pocketfinancer.reason-code-registry/2"},
    "predecessor": {"const": "pocketfinancer.reason-code-registry/1"},
    "legacy_meanings_frozen": {"const": true},
    "unknown_safety_code_policy": {"const": "retain_review"},
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "stage", "codes"],
        "properties": {
          "namespace": {"type": "string", "minLength": 1},
          "stage": {"enum": ["analysis", "triage", "selector_validation", "extractor_validation", "runtime", "account_resolution", "duplicate_assessment", "persistence_gate", "review", "settlement"]},
          "codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "meaning", "user_message", "severity", "safety_relevant", "allowed_outcomes"],
              "properties": {
                "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "meaning": {"type": "string", "minLength": 1},
                "user_message": {"type": "string", "minLength": 1},
                "severity": {"enum": ["info", "review", "terminal", "integrity"]},
                "safety_relevant": {"type": "boolean"},
                "allowed_outcomes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"enum": ["observe", "invoke", "discard", "retain_review", "retry_wait", "interrupted", "not_posted", "multiple_events", "blocked_by_mode", "invalid_operation", "eligible"]}
                }
              }
            }
          }
        }
      }
    }
  }
}
