{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pocketfinancer.user-feedback/1",
  "title": "Append-Only User Feedback Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "event_id", "operation_id_hash", "trace_hash", "revision", "action",
    "canonical_label_id", "created_at_epoch_ms", "actor_id_hash", "previous_event_hash"
  ],
  "properties": {
    "contract": {"const": "pocketfinancer.user-feedback/1"},
    "event_id": {"type": "string", "minLength": 1},
    "operation_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "action": {"enum": ["confirm", "correct", "reject", "request_review"]},
    "canonical_label_id": {"type": ["string", "null"]},
    "created_at_epoch_ms": {"type": "integer", "minimum": 0},
    "actor_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_event_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
