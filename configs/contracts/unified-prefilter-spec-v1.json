{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "unified-prefilter-spec-v1",
  "version": 1,
  "title": "PocketFinancer Unified Pre-SLM Triage Specification",
  "description": "Platform-neutral deterministic pre-SLM filter contract shared between Android (Kotlin) and iOS (Swift).",
  "author": "PocketFinancer Engineering",
  "updated_at": "2026-08-30",
  "architecture": {
    "goal": "Filter raw incoming SMS stream on-device before invoking Small Language Models (e.g., LFM2.5-350M, Gemma-270M) to minimize latency, eliminate false positive hallucinations, and save device battery.",
    "input_payload": {
      "sender": "string (sender address or alpha-tag, e.g. 'AD-HDFCBK', '+919876543210')",
      "body": "string (raw SMS text content)"
    },
    "output_disposition": {
      "eligible": "boolean (true if SMS must be forwarded to SLM inference; false if rejected deterministically)",
      "rejection_stage": "string | null (identifier of the earliest stage that rejected the SMS)",
      "rejection_reason": "string | null (human-readable explanation)"
    }
  },
  "ordered_stages": [
    {
      "stage_index": 1,
      "stage_id": "reject_empty_or_non_text",
      "action": "reject",
      "description": "Rejects empty strings, whitespace-only messages, and non-text media replacement placeholders (e.g. \\ufffc).",
      "rejection_code": "empty_body"
    },
    {
      "stage_index": 2,
      "stage_id": "reject_personal_mobile_sender",
      "action": "reject",
      "description": "Rejects messages sent from standard 10-15 digit personal phone numbers (P2P SMS), allowing bank 6-character alpha headers (e.g., 'VM-HDFCBK').",
      "pattern": "^\\+?[0-9]{10,15}$",
      "rejection_code": "personal_mobile_sender"
    },
    {
      "stage_index": 3,
      "stage_id": "reject_otp_or_verification",
      "action": "reject",
      "description": "Rejects OTPs, 2FA tokens, and login codes while safely preserving non-credential transaction wording like 'without OTP'.",
      "exception_pattern": "\\bwithout\\s+otp\\b",
      "pattern": "\\botp\\b|\\bone.?time.?password\\b|\\bverification.?code\\b",
      "rejection_code": "one_time_password"
    },
    {
      "stage_index": 4,
      "stage_id": "reject_collect_or_mandate_request",
      "action": "reject",
      "description": "Rejects inbound payment collect requests and mandate approval prompts before user authorization.",
      "pattern": "has\\s+requested\\s+money|requested\\s+Rs\\.?|collect\\s+request|mandate\\s+request|request\\s+from\\s+you",
      "rejection_code": "collect_request"
    },
    {
      "stage_index": 5,
      "stage_id": "reject_unsuccessful_transaction",
      "action": "reject",
      "description": "Rejects failed, declined, timed out, or uncompleted transactions where money did not move.",
      "pattern": "\\b(?:transaction|txn|payment|transfer|purchase|withdrawal|debit|credit)\\b[^.!?\\n]{0,32}\\b(?:failed|declined|unsuccessful|cancelled|canceled|rejected|not\\s+(?:successful|completed|processed))\\b|\\b(?:not|never)\\s+(?:been\\s+)?(?:debited|credited|deducted|paid|transferred|sent|received|withdrawn|deposited)\\b|\\b(?:amount|a/c|account|card)\\b[^.!?\\n]{0,24}\\b(?:not|never)\\s+(?:been\\s+)?(?:debited|credited|deducted)\\b|\\breversed\\s+before\\s+(?:completion|processing)\\b",
      "rejection_code": "unsuccessful_transaction"
    },
    {
      "stage_index": 6,
      "stage_id": "reject_bill_or_statement_generated_due",
      "action": "reject",
      "description": "Rejects credit card statement generated and utility bill due date reminders without executed payment settlement.",
      "pattern": "(?:bill|statement)\\s+generated\\b|(?:payment|bill)\\s+due\\s+date\\b|(?:min(?:imum)?|total)\\s+amount\\s+due\\b|is\\s+due\\s+on\\b|outstanding\\s+of\\s+Rs",
      "allow_if_contains": "(?:thank you for (?:making )?payment|payment received|debited|spent)",
      "rejection_code": "bill_generated_due"
    },
    {
      "stage_index": 7,
      "stage_id": "reject_standalone_promotions",
      "action": "reject",
      "description": "Rejects standalone marketing solicitations and pre-approved loan offers unless full transaction cues exist.",
      "pattern": "\\b(?:exclusive\\s+|special\\s+)?offers?\\b|\\bpre.?approved\\s+(?:loan|credit)\\b|\\b(?:shop|apply)\\s+now\\b|\\b(?:avail|get|enjoy)\\s+(?:up\\s+to\\s+)?\\d{1,3}%\\s+off\\b",
      "rejection_code": "standalone_promotion"
    },
    {
      "stage_index": 8,
      "stage_id": "require_currency_amount",
      "action": "require",
      "description": "Requires the presence of an explicit currency indicator and numeric amount (Rs., INR, ₹).",
      "pattern": "(?:rs\\.?|inr|\\u20b9)\\s*[\\d,]+(?:\\.\\d{1,2})?|[\\d,]+(?:\\.\\d{1,2})?\\s*(?:rs\\.?|inr|\\u20b9)",
      "rejection_code": "missing_currency_amount"
    },
    {
      "stage_index": 9,
      "stage_id": "require_masked_account_or_card",
      "action": "require",
      "description": "Requires an account/card mask (A/c XX1234, Card ending 1234), VPA address, or recognized issuing bank account marker.",
      "pattern": "a/c\\s*(?:no\\.?\\s*)?[X*x]+\\d+|a/?c\\s*(?:no\\.?\\s*)?\\*+\\d+|card\\s*(?:no\\.?\\s*)?[Xx*]+\\d+|card\\s+\\d{4}\\b|card\\s+ending\\s+[Xx*]*\\d+|vpa\\s+[a-zA-Z0-9.\\-_]+@[a-zA-Z0-9]+|\\b(?:hdfc|sbi|icici|axis|kotak|pnb|bob|paytm|canara|union)\\s+bank\\s+(?:a/c|card)\\b",
      "rejection_code": "missing_account_or_card"
    },
    {
      "stage_index": 10,
      "stage_id": "require_completed_transaction_verb",
      "action": "require",
      "description": "Requires an explicit past-tense or active financial movement verb indicating completed money flow.",
      "pattern": "\\b(?:debited|credited|deducted|spent|paid|received|transferred|sent|reversed|refunded|used|withdrawn|deposited)(?=[^a-zA-Z]|$)|\\btxn\\b|\\bhas\\s+(?:a\\s+)?debit\\s+by\\b|\\bhas\\s+credit\\s+for\\b|\\bwithout\\s+OTP\\b|\\bauto.?debit\\b|\\bDebit\\s+in\\s+a/c\\b|\\btxn\\s+of\\s+Rs\\b|\\bRedemption\\s+payout\\b|\\b(?:money\\s+transfer|amt\\s+sent|amt\\s+received)\\b|you've\\s+hand-?picked",
      "rejection_code": "missing_transaction_verb"
    }
  ],
  "platform_implementation_notes": {
    "android_kotlin": {
      "target_file": "pipeline/src/main/java/com/pocketfinancer/pipeline/SmsFilterPipeline.kt",
      "suggested_update": "Add stages 5 (reject_unsuccessful_transaction), 6 (reject_bill_or_statement_generated_due), and 7 (reject_standalone_promotions)."
    },
    "ios_swift": {
      "target_file": "PocketFinancer/Domain/AlertFilter.swift",
      "suggested_update": "Add stage 2 (reject_personal_mobile_sender) and sync Regex pattern enhancements for UPI VPA and bill generated."
    }
  }
}
